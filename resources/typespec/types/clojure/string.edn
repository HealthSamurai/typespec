;; Built-in typespec declarations for clojure.string.
;; Inert EDN, read as data from the classpath by typespec.core-types: nothing here is
;; evaluated or required. One map: qualified var symbol -> signature, in the same
;; format as project extern files. Every key must belong to clojure.string.

{;; These functions call Object.toString before converting the resulting string.
 clojure.string/upper-case  [some? :-> string?]
 clojure.string/lower-case  [some? :-> string?]
 clojure.string/capitalize  [some? :-> string?]
 clojure.string/trim        [java.lang.CharSequence :-> string?]
 clojure.string/triml       [java.lang.CharSequence :-> string?]
 clojure.string/trimr       [java.lang.CharSequence :-> string?]
 clojure.string/trim-newline [java.lang.CharSequence :-> string?]
 clojure.string/reverse     [java.lang.CharSequence :-> string?]
 clojure.string/re-quote-replacement [some? :-> string?]
 ;; The receiver is tested for truthiness before CharSequence methods are used.
 clojure.string/blank?      [(s/nilable (t/or false? java.lang.CharSequence)) :-> boolean?]
 ;; Elements and the separator are stringified.
 clojure.string/join        ([seqable? :-> string?]
                            [t/unknown seqable? :-> string?])
 clojure.string/split       ([java.lang.CharSequence java.util.regex.Pattern :-> (s/coll-of string? :kind vector?)]
                            [java.lang.CharSequence java.util.regex.Pattern int? :-> (s/coll-of string? :kind vector?)])
 clojure.string/split-lines [java.lang.CharSequence :-> (s/coll-of string? :kind vector?)]
 ;; These predicates invoke .toString on the receiver and pass the needle as is.
 clojure.string/starts-with? [some? string? :-> boolean?]
 clojure.string/ends-with?  [some? string? :-> boolean?]
 clojure.string/includes?   [some? java.lang.CharSequence :-> boolean?]
 clojure.string/index-of    ([some? (t/or string? char?) :-> (s/nilable int?)]
                             [some? (t/or string? char?) number? :-> (s/nilable int?)])
 clojure.string/last-index-of ([some? (t/or string? char?) :-> (s/nilable int?)]
                               [some? (t/or string? char?) number? :-> (s/nilable int?)])
 ;; Correlated pairs, not independent unions. A Pattern callback must handle
 ;; both ungrouped matches and vectors with nullable unmatched groups.
 clojure.string/replace     ([some? java.lang.Character java.lang.Character :-> string?]
                            [some? java.lang.CharSequence java.lang.CharSequence :-> string?]
                            [some? java.util.regex.Pattern java.lang.CharSequence :-> string?]
                            [some? java.util.regex.Pattern
                             [(t/or string? (s/coll-of (s/nilable string?) :kind vector?)) :-> string?]
                             :-> string?])
 ;; Character replacement uses str; a CharSequence match uses toString on replacement.
 clojure.string/replace-first ([some? java.lang.Character t/unknown :-> string?]
                               [some? java.lang.CharSequence some? :-> string?]
                               [some? java.util.regex.Pattern java.lang.CharSequence :-> string?]
                               [some? java.util.regex.Pattern
                                [(t/or string? (s/coll-of (s/nilable string?) :kind vector?)) :-> string?]
                                :-> string?])}
